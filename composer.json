{
  "name": "anastasiia/wp-pwa-builder",
  "description": "WordPress plugin foundation for building multiple PWA experiences.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "WP_PWA_Builder\\": "includes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "dump": "composer dump-autoload -o",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "stan": "phpstan analyse --memory-limit=1G"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "php-stubs/acf-pro-stubs": "^6.8",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpcsstandards/phpcsextra": "^1.5",
    "phpcsstandards/phpcsutils": "^1.2",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4"
  }
}
