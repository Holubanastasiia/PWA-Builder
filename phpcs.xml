<?xml version="1.0"?>

<ruleset name="WP PWA Builder">

    <description>Coding standard for the WP PWA Builder plugin.</description>

    <!-- Project files -->
    <file>includes</file>
    <file>templates</file>
    <file>wp-pwa-builder.php</file>

    <!-- Ignore dependencies -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- CLI output -->
    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- Supported versions -->
    <config name="minimum_wp_version" value="6.0"/>
    <config name="testVersion" value="8.1-"/>

    <!-- WordPress coding standards + recommended best practices -->
    <rule ref="WordPress-Extra">
        <!-- Project uses PSR-4 style class filenames -->
        <exclude name="WordPress.Files.FileName"/>

        <!-- Project does not use Yoda conditions -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- Short ternary is allowed when semantically appropriate -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
    </rule>

    <!-- Enforce plugin text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wp-pwa-builder"/>
            </property>
        </properties>
    </rule>

    <!-- PHP version compatibility -->
    <rule ref="PHPCompatibilityWP">
        <include-pattern>*\.php$</include-pattern>
    </rule>

</ruleset>